{
    "name": "sapient/core",
    "description": "Sapient AI Framework",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "psr/log": "^1.1 | ^2.0 | ^3.0"
    },
    "suggest": {
        "google/cloud-ai-platform": "Required for Vertex AI support (^1.50)",
        "team-reflex/discord-php": "^10.46",
        "qpdf": "Required for PDF Splitter functions"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jony Shark",
            "email": "brjprog@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sapient\\": "src/",
            "Sapient\\Hippocampus\\": "hippocampus/src/",
            "Sapient\\Sandbox\\": "sandbox/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
