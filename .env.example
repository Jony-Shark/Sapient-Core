# Sapient Framework Configuration
# Copy this file to .env and adjust as needed

# Basic dirs
DATA_DIR=./data
LOG_DIR=./log

# Persona
PERSONA=helix

# LLM Backend
# Options: ollama, gemini
LLM_DRIVER=ollama

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_BASE_MODEL=llama3
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192

# Vertex AI / Gemini Configuration
GOOGLE_APPLICATION_CREDENTIALS={path_to_credential_file}
GEMINI_API_KEY={simple_api_key}
GEMINI_PROJECT_ID=my-gcp-project-123
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# OpenAI Configuration
OPENAI_API_KEY={bearer-token}
OPENAI_URL={openai-compatible-api-url}

# Anthropic Configuration
ANTHROPIC_API_KEY={anthropic-api-key}

# HTTP Request Timeout (in milliseconds)
HTTP_REQUEST_TIMEOUT=180000

# Memory Service (Hippocampus)
HIPPOCAMPUS_URL=http://localhost:6366
